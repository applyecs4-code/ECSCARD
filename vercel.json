{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/*.mjs": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/admin/receive.php", "destination": "/api/admin-api?__p=/receive" },
    { "source": "/admin/enquiry.php", "destination": "/api/admin-api?__p=/enquiry" },
    { "source": "/admin-api/:path*", "destination": "/api/admin-api?__p=/:path*" },
    { "source": "/blog", "destination": "/api/admin-api?__p=/blog-index" },
    { "source": "/blog/", "destination": "/api/admin-api?__p=/blog-index" },
    { "source": "/blog/:slug", "destination": "/api/admin-api?__p=/blog-post/:slug" },
    { "source": "/blog-sitemap.xml", "destination": "/api/admin-api?__p=/blog-sitemap" },
    { "source": "/site-custom.css", "destination": "/api/admin-api?__p=/site-css" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
