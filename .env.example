# ---- Netlify > Site configuration > Environment variables ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...            # Supabase > Project Settings > API > service_role (SECRET, never put in site files)
SESSION_SECRET=put-a-long-random-string-here-32+chars

# Email (SMTP). Works with your host's SMTP, Gmail app-password, Brevo, Resend SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=booking@applyecscard.co.uk
SMTP_PASS=your-smtp-password
MAIL_FROM="Apply ECS <booking@applyecscard.co.uk>"

# Optional: first-login credentials (defaults = your old PHP panel login). Change later in Admin > Account.
# ADMIN_EMAIL=booking@applyecscard.co.uk
# ADMIN_PASSWORD_HASH=$2y$10$...
